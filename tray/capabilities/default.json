{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The dashboard and mini popover (served by the local TokenHUD server) may call the tray shell commands and drag the frameless popover.",
  "windows": ["main", "mini"],
  "remote": { "urls": ["http://127.0.0.1:4317/*", "http://localhost:4317/*"] },
  "permissions": ["core:default", "core:window:allow-start-dragging", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-is-maximized"]
}
